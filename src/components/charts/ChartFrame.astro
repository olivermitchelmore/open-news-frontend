---
interface Props {
  title: string;
  subtitle?: string;
  source?: string;
  data: [string, string][];
}

const { title, subtitle, source, data } = Astro.props;
---

<figure class="chart wide" aria-label={title}>
  <figcaption>
    <p class="title">{title}</p>
    {subtitle && <p class="subtitle">{subtitle}</p>}
  </figcaption>

  <div class="plot">
    <slot />
  </div>

  <div class="footer">
    {source && <p class="source">Source: {source}</p>}
    <details>
      <summary>View data</summary>
      <table>
        <tbody>
          {
            data.map(([label, value]) => (
              <tr>
                <th scope="row">{label}</th>
                <td>{value}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </details>
  </div>
</figure>

<style>
  .chart {
    --chart-1: var(--accent);
    --chart-muted: color-mix(in srgb, var(--ink) 22%, var(--bg));
    --chart-grid: var(--rule);
    padding-block: 1.5rem 1rem;
    border-block: 1px solid var(--rule);
    font-family: var(--font-sans);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .title {
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.3;
    color: var(--ink);
  }

  .subtitle {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--ink-3);
  }

  .plot {
    margin-top: 1.5rem;
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--ink-2);
  }

  summary:hover {
    color: var(--ink);
  }

  details[open] {
    flex-basis: 100%;
  }

  table {
    width: 100%;
    margin-top: 0.75rem;
    border-collapse: collapse;
    font-size: 0.8125rem;
  }

  th,
  td {
    padding: 0.375rem 0;
    border-bottom: 1px solid var(--rule);
    font-weight: 400;
    text-align: left;
    color: var(--ink-2);
  }

  td {
    text-align: right;
    color: var(--ink);
  }
</style>
