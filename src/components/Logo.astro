---
interface Props {
  size?: 'md' | 'lg';
}

const { size = 'md' } = Astro.props;
---

<span class:list={['logo', `logo-${size}`]}>
  <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
    <circle
      cx="16"
      cy="16"
      r="11.5"
      fill="none"
      stroke="currentColor"
      stroke-width="5"
      stroke-dasharray="60 12.3"
      transform="rotate(-38 16 16)"
    />
  </svg>
  <span class="wordmark">Open News</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
  }

  .mark {
    width: 0.9em;
    height: 0.9em;
    color: var(--accent);
    transition: transform 0.6s var(--ease);
  }

  :global(a:hover) > .logo .mark {
    transform: rotate(-120deg);
  }

  .logo-lg {
    font-size: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    gap: 0.75rem;
  }
</style>
