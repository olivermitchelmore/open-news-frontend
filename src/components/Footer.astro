---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { categories } from '../lib/categories';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="intro">
        <a href="/" aria-label="Open News home" class="brand"><Logo size="lg" /></a>
        <p>Independent reporting from around the world, openly published.</p>
      </div>

      <nav class="links" aria-label="Footer">
        <div>
          <h2>Sections</h2>
          <ul role="list">
            {categories.map((c) => <li><a href={`/${c.slug}/`}>{c.name}</a></li>)}
          </ul>
        </div>
        <div>
          <h2>Explore</h2>
          <ul role="list">
            <li><a href="/">Front page</a></li>
            <li><a href="/search/">Search</a></li>
            <li>
              <a href="/rss.xml" class="with-icon">RSS feed <Icon name="rss" size={14} /></a>
            </li>
            <li><a href="/sitemap-index.xml">Sitemap</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="bottom">
      <p>&copy; {year} Open News</p>
      <a href="#top" class="to-top">Back to top</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(4rem, 8vw, 7rem);
    background: var(--inverse-bg);
    color: var(--inverse-ink);
  }

  .top {
    display: grid;
    gap: 3rem;
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .brand {
    display: inline-block;
    color: var(--inverse-ink);
  }

  .brand :global(.mark) {
    color: var(--inverse-accent);
  }

  .intro p {
    max-width: 30ch;
    margin-top: 1.25rem;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--inverse-ink-2);
  }

  .links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  h2 {
    margin-bottom: 1rem;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--inverse-ink-2);
  }

  ul {
    display: grid;
    gap: 0.625rem;
  }

  .links a {
    font-size: 0.9375rem;
    color: var(--inverse-ink);
    transition: color 0.2s var(--ease);
  }

  .links a:hover {
    color: var(--inverse-accent);
  }

  .with-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--inverse-rule);
    font-size: 0.8125rem;
    color: var(--inverse-ink-2);
  }

  .to-top:hover {
    color: var(--inverse-ink);
  }

  @media (min-width: 900px) {
    .top {
      grid-template-columns: 1.4fr 1fr;
      align-items: end;
    }
  }
</style>
