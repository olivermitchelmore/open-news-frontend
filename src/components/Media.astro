---
import { Picture } from 'astro:assets';
import type { ArticleImage } from '../lib/articles';

interface Props {
  image?: ArticleImage;
  sizes: string;
  widths?: number[];
  ratio?: string;
  eager?: boolean;
  transitionName?: string;
  class?: string;
}

const {
  image,
  sizes,
  widths = [400, 640, 960, 1280, 1600],
  ratio = '3 / 2',
  eager = false,
  transitionName,
  class: className,
} = Astro.props;
---

<div class:list={['media', className]} style={`--ratio: ${ratio}`}>
  {
    image ? (
      <Picture
        src={image.src}
        alt={image.alt}
        inferSize
        widths={widths}
        sizes={sizes}
        formats={['avif']}
        fallbackFormat="webp"
        quality={55}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding={eager ? 'sync' : 'async'}
        style={transitionName ? `view-transition-name: ${transitionName}` : undefined}
      />
    ) : (
      <div class="placeholder" aria-hidden="true">
        <span />
      </div>
    )
  }
</div>

<style>
  .media {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
    isolation: isolate;
  }

  .media :global(picture),
  .media :global(img) {
    width: 100%;
    height: 100%;
  }

  .media :global(img) {
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }

  :global(.card:hover) .media :global(img) {
    transform: scale(1.035);
  }

  .placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(120% 90% at 85% 10%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 60%),
      linear-gradient(135deg, var(--surface), var(--surface-2));
  }

  .placeholder span {
    width: 18%;
    aspect-ratio: 1;
    border: clamp(4px, 1.4vw, 10px) solid var(--accent);
    border-radius: 50%;
    opacity: 0.85;
  }
</style>
